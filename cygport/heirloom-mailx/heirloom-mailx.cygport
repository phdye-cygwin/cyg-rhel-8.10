NAME="heirloom-mailx"
VERSION=12.5
RELEASE=1
CATEGORY="Mail"
SUMMARY="Heirloom mailx (nail), the mail user agent RHEL ships as /bin/mailx"
DESCRIPTION="Heirloom mailx, formerly known as nail, is a BSD Mail derivative
with MIME, IMAP, POP3, SMTP and S/MIME support. This is the exact program
Red Hat Enterprise Linux 8 ships as the 'mailx' package (upstream 12.5), so it
gives a RHEL-parity /usr/bin/mailx with the 'mail' and 'Mail' aliases. It sends
through any sendmail-compatible MTA; on this replica that is Postfix at
/usr/sbin/sendmail."
HOMEPAGE="https://heirloom.sourceforge.net/mailx.html"

# Upstream's SourceForge project only carries mailx up to 12.4; 12.5 (2011) was
# never posted there. This is the exact 12.5 Red Hat builds from, served by the
# CentOS Stream lookaside cache (md5 836bf1da322d2d1f78b7056c2b3b2304), repacked
# to xz. Same tree that lands in the RHEL srpm.
# Pristine .orig.tar.gz fallback, if that host ever moves:
#   https://snapshot.debian.org/file/2fa7f300dea7747e5880d61fd691a103d70863ba
SRC_URI="https://sources.stream.centos.org/sources/rpms/mailx/mailx-${VERSION}.tar.xz/836bf1da322d2d1f78b7056c2b3b2304/mailx-${VERSION}.tar.xz"
SRC_DIR="mailx-${VERSION}"

# Security + portability patches, taken verbatim from Debian's last release
# (12.5-4). 0011-0014 are the CVE-2014-7844 "expandaddr" fixes: without them a
# mail address beginning with '-' or carrying shell metacharacters can run
# commands. RHEL carries the same fixes, so parity wants them too.
#
# For an archival, self-contained port: download these four next to this file
# and change PATCH_URI to the bare filenames. sources.debian.org is convenient
# but it is not forever.
PATCH_URI="
https://sources.debian.org/data/main/h/heirloom-mailx/12.5-4/debian/patches/0011-outof-Introduce-expandaddr-flag.patch
https://sources.debian.org/data/main/h/heirloom-mailx/12.5-4/debian/patches/0012-unpack-Disable-option-processing-for-email-addresses.patch
https://sources.debian.org/data/main/h/heirloom-mailx/12.5-4/debian/patches/0013-fio.c-Unconditionally-require-wordexp-support.patch
https://sources.debian.org/data/main/h/heirloom-mailx/12.5-4/debian/patches/0014-globname-Invoke-wordexp-with-WRDE_NOCMD.patch
"

# Runtime: mail(1) needs an MTA that provides /usr/sbin/sendmail. On this box
# that is postfix. cygport auto-detects the library deps (cygwin, libiconv2,
# and libcrypto/libssl when SSL is on); the MTA is a program dep, so name it.
REQUIRES="postfix"

# ---------------------------------------------------------------------------
# SSL profile.
#
# mailx 12.5 (2011) predates OpenSSL 1.1's opaque structs. Its openssl.c will
# NOT compile against the 1.1.1 that this snapshot ships. Two ways out:
#
#   _WANT_SSL=0  (default) Build without TLS/S-MIME. Guaranteed clean compile.
#                For local delivery through a loopback Postfix you never open a
#                TLS socket anyway, so nothing is lost for that use.
#
#   _WANT_SSL=1  RHEL-faithful. Requires the OpenSSL-1.1 compatibility patch
#                from RHEL's own mailx-12.5-29.el8 SRPM. Drop that patch beside
#                this file and add it to PATCH_URI (see README). Then mailx gets
#                the same S/MIME + STARTTLS surface as the stock RHEL binary.
# ---------------------------------------------------------------------------
: "${_WANT_SSL:=0}"

# Non-VPATH build. Copy the tree into ${B} so ${S} (the -src package) stays
# clean, then build in place.
src_compile() {
	cp -rp ${S}/. ${B}/
	cd ${B}

	# Cygwin's libc provides getopt(), and cygwin1.dll exports optind/optarg.
	# mailx bundles its own getopt.c; on Cygwin main.c binds optind to the DLL
	# copy while the bundled getopt advances its own, so option flags like -s
	# and -v get mis-collected as recipients (you see RCPT TO:<-s>). Drop the
	# bundled getopt and link libc's, so main.c and getopt() share one optind.
	sed -i 's/ getopt\.o//' Makefile

	# Generate config.h and LIBS first (this fires makeconfig, which probes
	# for iconv/sockets/ssl by link tests). Doing it as its own step lets us
	# edit the result before the objects are built. Build the single target
	# config.h, not "config.h LIBS": that rule's one recipe writes both, and
	# asking for both under -j races makeconfig against itself. Serial, and
	# direct make so cygport's exported CC/CFLAGS carry into the nested probes.
	make -j1 ${_make_vars} config.h

	if [ "${_WANT_SSL}" != "1" ]; then
		# makeconfig will happily light up USE_OPENSSL because the probe only
		# links SSLv23_client_method()+PEM_read_PrivateKey(), which resolve
		# fine against 1.1.1. The real openssl.c then fails. Strip SSL back
		# out of the generated config so openssl.o/ssl.o/nss.o compile empty
		# and the link drops -lssl/-lcrypto. Everything else stays.
		sed -i -e '/#define USE_SSL/d' \
		       -e '/#define USE_OPENSSL/d' \
		       -e '/#define USE_NSS/d' \
		       -e '/#define HAVE_STACK_OF/d' \
		       -e '/#define HAVE_GENNAME_H/d' \
		       -e '/#define HAVE_XCONST_H/d' \
		       config.h
		sed -i -e 's/-lssl//g'   -e 's/-lcrypto//g' \
		       -e 's/-lsmime3//g' -e 's/-lnss3//g' -e 's/-lssl3//g' \
		       -e 's/-lnspr4//g'  -e 's/-lplc4//g' \
		       LIBS
	fi

	# Keep config.h/LIBS newer than makeconfig so the main build won't
	# regenerate (and undo the edit above).
	touch config.h LIBS

	cygmake ${_make_vars}
}

src_install() {
	cd ${B}
	cyginstall ${_make_vars}

	# RHEL ships mailx plus 'mail' and 'Mail' aliases. Cygwin's filesystem is
	# case-insensitive, so 'Mail' and 'mail' are the same name: creating both
	# just clobbers one, and a case-insensitive lookup already resolves 'Mail'
	# to this binary. Install the lowercase names only.
	dosym mailx /usr/bin/mail
	dosym mailx.1 /usr/share/man/man1/mail.1

	dodoc AUTHORS README INSTALL ChangeLog TODO
}

# Build/install variables shared by both make passes. Notes on the deviations
# from upstream defaults:
#   MAILRC=/etc/mail.rc    RHEL's name; upstream default is /etc/nail.rc
#   MAILSPOOL=/var/spool/mail  where Cygwin Postfix's local(8) delivers
#   SENDMAIL=/usr/sbin/sendmail  the Postfix sendmail shim
#   UCBINSTALL=/usr/bin/install  upstream wants /usr/ucb/install (SunOS-ism)
#   STRIP=:                let cygport strip and split debuginfo, not the Makefile
#   IPv6=-DHAVE_IPv6_FUNCS getaddrinfo() works on Cygwin; the probe for it ships
#                          commented out, so turn it on by hand as RHEL does
_make_vars="
	PREFIX=/usr
	BINDIR=/usr/bin
	MANDIR=/usr/share/man
	SYSCONFDIR=/etc
	MAILRC=/etc/mail.rc
	MAILSPOOL=/var/spool/mail
	SENDMAIL=/usr/sbin/sendmail
	UCBINSTALL=/usr/bin/install
	STRIP=:
	IPv6=-DHAVE_IPv6_FUNCS
"
