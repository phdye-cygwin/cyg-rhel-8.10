__pycache__/
*.pyc

# Per-site / local config: anything with "local" in the name stays out of the
# repo. Committed example templates are the exception (they show what the local
# file should contain).
*local*
!*local*.example.*

# Logs belong in bug reports, not the repo - ignore them all. The *unredacted*
# guard also catches a raw capture saved under some other extension.
*.log
*unredacted*
